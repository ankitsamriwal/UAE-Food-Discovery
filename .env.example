# Supabase project settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudinary dashboard (cloud name) + Settings > Upload > Upload presets (unsigned preset)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Google Cloud Console > APIs & Services > Credentials (Maps JavaScript API key,
# with billing enabled) + Google Maps Platform > Map Management (a Map ID with
# Advanced Markers enabled, referenced as "UAE_FOOD_DIRECTORY_MAP" in code)
VITE_GOOGLE_MAPS_API_KEY=
